{
	"name": "Social Home Dev Container",
	"image": "mcr.microsoft.com/devcontainers/python:3.14",

	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"upgradePackages": true
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// ``chromium-driver`` pulls in Debian's ``chromium`` package, which
		// lands the launcher at ``/usr/bin/chromium``. That launcher is a
		// shell wrapper that sources ``/etc/chromium.d/*.conf`` for extra
		// flags, so the ``--no-sandbox`` + ``--disable-dev-shm-usage`` pair
		// the chrome-devtools-mcp plugin needs inside an unprivileged
		// container is dropped in via ``postCreateCommand`` below rather
		// than via a custom dpkg-divert wrapper. ``xvfb`` provides the
		// headful display target the plugin opens via ``DISPLAY=:99``.
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": "xvfb chromium-driver"
		}
	},

	// One-time setup after the container is created (chromium flags
	// config, venv, Python deps, pre-commit hooks, pnpm, frontend
	// deps) — see ``.devcontainer/post-create.sh`` for the per-step
	// breakdown. Kept as a script so quoting is straightforward and
	// ``set -e`` aborts on the first failure.
	"postCreateCommand": ".devcontainer/post-create.sh",

	// (Re)start Xvfb on every container boot — see
	// ``.devcontainer/post-start.sh``. The chrome-devtools-mcp
	// plugin reads ``$DISPLAY`` from ``containerEnv`` below, not
	// from a login shell, so the value has to live on the
	// container's environment, not just ``~/.bashrc``.
	"postStartCommand": ".devcontainer/post-start.sh",
	"containerEnv": {
		// Always recreate the venv on rebuild instead of prompting
		// to replace an existing one. Equivalent to ``--clear`` on
		// every ``uv venv`` invocation in this container.
		"UV_VENV_CLEAR": "1",
		// Hardlink mode for ``uv pip install`` is ~2-3× faster than
		// copy mode but only works when the cache and the target
		// venv live on the **same filesystem**. The default cache
		// at ``~/.cache/uv`` sits on the container's overlay FS,
		// while ``.venv/`` lives on the bind-mounted workspace
		// volume → hardlinks fail and uv warns. Pinning the cache
		// inside the workspace puts both on the same FS, so
		// hardlinks work and the warning goes away.
		"UV_LINK_MODE": "hardlink",
		"UV_CACHE_DIR": "${containerWorkspaceFolder}/.uv-cache",
		// Xvfb runs on display :99 (see ``postStartCommand``). The
		// chrome-devtools-mcp plugin runs out of the container's
		// environment, not a login shell, so the value lives here
		// rather than in ``~/.bashrc``.
		"DISPLAY": ":99",
		// chrome-devtools-mcp delegates browser discovery to
		// Puppeteer, which honours ``PUPPETEER_EXECUTABLE_PATH``
		// before falling back to bundled Chrome. Pointing it at the
		// system Chromium installed by ``chromium-driver`` skips the
		// Puppeteer download and uses the in-image binary. The
		// upstream ``CHROME_PATH`` is the historical name and is
		// honoured by other tooling (e.g. puppeteer-core, some
		// Karma launchers) — set both so any downstream consumer
		// sees the same binary.
		"PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium",
		"CHROME_PATH": "/usr/bin/chromium"
	},

	// No port forwarding: dev servers, test instances and headless Chromium
	// debug ports (agents start many of them) must never be forwarded to the
	// host automatically. Forward one by hand from the Ports view when you
	// need it (8099 = aiohttp backend, 5173 = Vite dev server).
	"otherPortsAttributes": { "onAutoForward": "ignore" },

	"customizations": {
		"vscode": {
			"settings": {
				"remote.autoForwardPorts": false,
				"remote.restoreForwardedPorts": false,
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.pytestArgs": ["tests"],
				"python.terminal.activateEnvironment": true,
				"editor.formatOnSave": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.codeActionsOnSave": {
						"source.fixAll.ruff": "explicit",
						"source.organizeImports.ruff": "explicit"
					}
				},
				"[typescript]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint"
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint"
				},
				"files.exclude": {
					"**/__pycache__": true,
					"**/.pytest_cache": true,
					"**/.ruff_cache": true,
					"**/.mypy_cache": true,
					"**/node_modules": true
				}
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"dbaeumer.vscode-eslint",
				"vitest.explorer",
				"esbenp.prettier-vscode"
			]
		}
	}
}

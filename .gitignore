# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.venv
.venv/
.uv-cache/
venv/
env/

# Generated by hatch-vcs during ``python -m build`` — holds the
# version string derived from the latest git tag. Re-derived on
# every build, so committing it would just create stale diffs.
socialhome/_version.py

# Data / secrets
*.sqlite
*.sqlite-wal
*.sqlite-shm
/data/
social_home.toml
.env
.env.*
integration_token.txt

# Frontend
client/node_modules/
client/dist/
client/coverage/
client/vite.config.ts.timestamp-*.mjs
socialhome/static/*
!socialhome/static/.gitkeep
# GFS bundle outputs from client/vite.gfs.config.ts. The directory
# also contains handcrafted SSR assets (avatar_placeholder.svg,
# users_directory.css/js) that stay tracked — gitignore the vite
# outputs by name (or by hash-suffix glob) so they don't churn git
# diffs on every release.
socialhome/global_server/static/admin.css
socialhome/global_server/static/admin.js
socialhome/global_server/static/highlight_public_viewer.js
socialhome/global_server/static/*.module-*.js
*.tsbuildinfo

# IDE — track shared tasks + launch configs + recommended
# extensions so every contributor gets the same dev-container UX,
# but ignore individual ``settings.json`` and other per-user state.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# Superpowers brainstorming companion — drops mockup HTML, server
# state, and event logs under ``.superpowers/brainstorm/<session>/``
# when launched with ``--project-dir`` so they survive across
# conversation turns. The artefacts are scratch-only and not meant
# to be tracked.
.superpowers/

# Superpowers implementation plans — agent scratch kept local to the
# working copy, never committed upstream.
docs/superpowers/

# Local Claude Code git worktrees and UX-gate screenshot scratch —
# working-copy-only, never committed upstream.
.claude/worktrees/
.uxgate/

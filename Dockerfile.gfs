# Global Federation Server (GFS) image — the public relay (§24).
#
# Entry point: ``socialhome-global-server`` (console script defined
# in pyproject.toml, pointing at ``socialhome.global_server.server:main``).
# Port: 8765 (default; overridable via GFS_PORT env var).
#
# Installs from the same pre-built wheel as the core image, with the
# ``[global-server]`` extra added on top. The frontend bundles for the
# GFS public landing pages live under
# ``socialhome/global_server/static/`` and are checked into git, so
# they ride the wheel without a separate node build.
#
# Runtime differs from the core image:
#   * No ffmpeg / Pillow heavy deps — GFS never transcodes media.
#   * Installs the ``global-server`` extra (bcrypt + qrcode[pil]).
#
# Published as ``ghcr.io/social-home-io/gfs:{tag}`` by the
# ``docker-gfs`` job in .github/workflows/publish.yml.

FROM python:3.14-slim AS base

# uv replaces pip for the wheel install — ~10× faster, and ships static
# via the official ``ghcr.io/astral-sh/uv`` image so we don't depend on an
# extra apt / pip-bootstrap layer. Pinned (not ``:latest``) so a rebuild of
# the same tag uses the same installer — keep it equal to the
# ``setup-uv`` version in .github/workflows/ci.yml.
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /usr/local/bin/

# Minimal system deps. qrcode[pil] pulls Pillow, which needs libjpeg +
# libwebp for the landing-page QR image rendering (§24 onboarding).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libjpeg-turbo-progs \
      libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 gfsuser && \
    useradd  --system --uid 10001 --gid gfsuser --create-home gfsuser

WORKDIR /app

# Pre-built wheel from the publish workflow's ``build`` job. The
# job captures the exact PEP 427 filename and passes it via
# ``--build-arg WHEEL``. The ``[global-server]`` extra (bcrypt +
# qrcode[pil]) comes in through the locked set below.
#
# Dependencies come from the lock, not from a fresh resolve:
# ``uv export --frozen`` turns the committed ``uv.lock`` into a requirements
# file (core + ``[global-server]``) that pins every package, transitive ones included,
# with the sha256 of each published file — the same flags as
# ``scripts/lock.sh --export gfs``, which prints it locally. ``--frozen``
# reads the lock as-is (no resolve, no network). Step 1 installs exactly
# that set — ``--require-hashes`` refuses any file whose hash isn't listed.
# Step 2 adds the wheel itself with ``--no-deps`` (it was built in the same
# workflow, so it has no published hash), and ``uv pip check`` fails the
# build if the lock and the wheel's own requirements ever disagree.
# ``--system`` installs into the base image's site-packages directly
# (no venv); ``--no-cache`` keeps the layer size down.
ARG WHEEL
COPY pyproject.toml uv.lock /tmp/lock/
COPY dist/${WHEEL} /tmp/${WHEEL}
RUN uv export --no-cache --frozen --no-dev --no-emit-project --no-header \
      --format requirements-txt --extra global-server --project /tmp/lock \
      > /tmp/requirements.txt && \
    uv pip install --system --no-cache --require-hashes -r /tmp/requirements.txt && \
    uv pip install --system --no-cache --no-deps "/tmp/${WHEEL}" && \
    uv pip check --system && \
    rm -rf /tmp/lock /tmp/requirements.txt /tmp/${WHEEL}

# /var/lib/sh-gfs is the spec's default GFSDATA_DIR (config.py). Use
# a volume so operators can persist the config + SQLite across
# container restarts. Bootstrapping: run ``socialhome-global-server
# --init --config /var/lib/sh-gfs/global_server.toml`` once in a
# throwaway container, set ``base_url`` + the admin password, then
# mount the resulting file.
RUN mkdir -p /var/lib/sh-gfs && chown -R gfsuser:gfsuser /var/lib/sh-gfs

VOLUME /var/lib/sh-gfs

# NB: we deliberately do NOT bake GFS_HOST / GFS_PORT here. The CMD below
# passes a --config file, and GFS layers env over the file (env > file >
# defaults); baking these would pin them above the file and silently
# shadow its [server] host/port (issue #563). They stay opt-in overrides:
# set GFS_PORT at `docker run` time to retarget a single instance. The
# dataclass defaults (0.0.0.0:8765) already apply when neither is set.
EXPOSE 8765

USER gfsuser

CMD ["socialhome-global-server", "--config", "/var/lib/sh-gfs/global_server.toml"]

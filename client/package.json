{
  "name": "socialhome-client",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.gfs.config.ts",
    "build:gfs": "vite build --config vite.gfs.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"gfs/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.js",
    "fonts:check": "node scripts/fonts-check.js",
    "i18n:status": "curl -sf \"$WEBLATE_URL/api/components/socialhome/ui/statistics/\" -H \"Authorization: Token $WEBLATE_TOKEN\"",
    "lint:circular": "madge --circular --ts-config tsconfig.json --extensions ts,tsx src gfs"
  },
  "dependencies": {
    "@preact/signals": "^2.9.1",
    "@types/leaflet": "^1.9.21",
    "dompurify": "^3.4.8",
    "leaflet": "^1.9.4",
    "marked": "^18.0.4",
    "preact": "^10.29.2",
    "preact-iso": "^2.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}

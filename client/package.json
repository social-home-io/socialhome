{
  "name": "socialhome-client",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.gfs.config.ts",
    "build:gfs": "vite build --config vite.gfs.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"gfs/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.js",
    "fonts:check": "node scripts/fonts-check.js",
    "i18n:status": "curl -sf \"$WEBLATE_URL/api/components/socialhome/ui/statistics/\" -H \"Authorization: Token $WEBLATE_TOKEN\"",
    "lint:circular": "madge --circular --ts-config tsconfig.json --extensions ts,tsx src gfs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@types/leaflet": "^1.9.22",
    "dompurify": "^3.4.17",
    "leaflet": "^1.9.4",
    "marked": "^18.1.1",
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "madge": "^8.0.0",
    "preact-render-to-string": "^6.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

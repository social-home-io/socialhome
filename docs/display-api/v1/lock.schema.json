{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-home.io/schemas/display-api/v1/lock.schema.json",
  "title": "The lock screen — 423 from any bearer endpoint of a locked panel, 200 from POST /lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "clock",
    "dir",
    "household",
    "is_night",
    "locale",
    "locked",
    "strings"
  ],
  "properties": {
    "api_version": {
      "$ref": "common.schema.json#/$defs/api_version"
    },
    "locked": {
      "const": true
    },
    "household": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "dir": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "clock": {
      "$ref": "common.schema.json#/$defs/clock"
    },
    "is_night": {
      "type": "boolean",
      "description": "The household's night window is on: draw the lock screen with the night palette and dim, as on the night board."
    },
    "strings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delete",
        "enter_pin",
        "forgot_pin",
        "last_try",
        "locked",
        "pin_button",
        "tries_left",
        "unlock",
        "wrong_pin"
      ],
      "properties": {
        "locked": {
          "type": "string"
        },
        "pin_button": {
          "type": "string"
        },
        "enter_pin": {
          "type": "string"
        },
        "unlock": {
          "type": "string"
        },
        "delete": {
          "type": "string"
        },
        "wrong_pin": {
          "type": "string"
        },
        "tries_left": {
          "type": "string",
          "description": "Under \"Wrong PIN\" with 2+ tries left; {n} is the DISPLAY_PIN_WRONG params.remaining."
        },
        "last_try": {
          "type": "string",
          "description": "Under \"Wrong PIN\" instead of tries_left when params.remaining is 1: the next wrong PIN unpairs the panel."
        },
        "forgot_pin": {
          "type": "string",
          "description": "Under the PIN pad: who can change a forgotten PIN."
        }
      }
    }
  }
}

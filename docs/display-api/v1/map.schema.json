{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-home.io/schemas/display-api/v1/map.schema.json",
  "title": "GET /api/display/v1/map",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/header"
    }
  ],
  "type": "object",
  "properties": {
    "api_version": true,
    "view": {
      "const": "map"
    },
    "view_key": true,
    "household": true,
    "locale": true,
    "dir": true,
    "clock": true,
    "settings": true,
    "rail": true,
    "people": true,
    "is_night": true,
    "night": true,
    "tab": {
      "enum": [
        "overview",
        "messages",
        "notes",
        "map"
      ]
    },
    "tabs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/tab"
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/mention"
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribution",
        "bubbles",
        "image",
        "label",
        "pins",
        "spots",
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "image": {
          "description": "The map as one picture: GET {url}?w=&h=&scheme=light|dark (bearer, PNG). width/height are the default size (the firmware's map area); w is held to 200-1920 and h to 200-1200. etag is the ETag the default picture (default size, light) has now; a picture of another size or scheme has its own ETag — revalidate it with If-None-Match. null when the server has no tile source.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "etag",
            "height",
            "url",
            "width"
          ],
          "properties": {
            "url": {
              "const": "/api/display/v1/map.png"
            },
            "width": {
              "type": "integer",
              "minimum": 200,
              "maximum": 1920
            },
            "height": {
              "type": "integer",
              "minimum": 200,
              "maximum": 1200
            },
            "etag": {
              "type": "string",
              "pattern": "^\"[0-9a-f]{32}\"$"
            }
          }
        },
        "spots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "age_label",
              "icon",
              "iso",
              "lat",
              "lon",
              "name",
              "person",
              "place",
              "stale",
              "when",
              "zone"
            ],
            "properties": {
              "person": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "$ref": "common.schema.json#/$defs/emoji"
              },
              "place": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "age_label": {
                "type": "string"
              },
              "iso": {
                "type": "string"
              },
              "stale": {
                "type": "boolean"
              },
              "zone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lat": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lon": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "bubbles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "age",
              "away",
              "caption",
              "key",
              "label",
              "lat",
              "lon",
              "members",
              "more",
              "stale",
              "zone"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "zone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "more": {
                "type": "integer"
              },
              "caption": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "stale": {
                "type": "boolean"
              },
              "age": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "away": {
                "type": "boolean"
              }
            }
          }
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "icon",
              "id",
              "is_home",
              "lat",
              "lon",
              "name",
              "occupied",
              "radius_m"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "$ref": "common.schema.json#/$defs/emoji"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "radius_m": {
                "type": "integer"
              },
              "color": {
                "$ref": "common.schema.json#/$defs/color"
              },
              "is_home": {
                "type": "boolean"
              },
              "occupied": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "tab",
    "tabs",
    "alerts",
    "map"
  ],
  "unevaluatedProperties": false
}

{#- Home's Notes tab: every household sticky on a flat board, each in its
    own colour (softened toward the page) with the warm note ink. -#}
{% from "_macros.html.j2" import tab_empty with context %}
<div class="dash-notes-page">
  <h1 class="dash-visually-hidden">{{ t("dashboard.tabs.notes") }}</h1>
  {% if notes %}
  <ul class="dash-note-board">
    {% for s in notes %}<li class="dash-note {{ f.kc(s.color) }}">{{ s.content }}</li>{% endfor %}
  </ul>
  {#- Past the wall's hard bound: how many more the app holds. -#}
  {% if notes_beyond %}<p class="dash-more">{{ t("dashboard.home.shopping_more", n=notes_beyond) }}</p>{% endif %}
  {% else %}
  {{ tab_empty("📝", t("dashboard.notes.empty"), t("dashboard.notes.empty_hint")) }}
  {% endif %}
</div>

{#- Shared bits. Import "with context" (they use f and t). -#}

{#- A person's face: their picture, else initials on their colour. The
    name is spoken (visually hidden) unless `named` shows it. -#}
{% macro face(p, size="md", named=False) -%}
<span class="dash-face dash-face-{{ size }} {{ f.kc(p.color) }}" aria-hidden="true">
{%- set url = f.avatar(p) -%}
<span class="dash-initials">{{ p.initials }}</span>
{%- if url %}<img src="{{ url }}" alt="" decoding="async">{% endif -%}
</span>
{%- if named %}<span class="dash-face-name">{{ p.display_name }}</span>{% else %}<span class="dash-visually-hidden">{{ p.display_name }}</span>{% endif %}
{%- endmacro %}

{#- Small faces for everyone an item belongs to. -#}
{% macro faces(item) -%}
<span class="dash-faces">{% for p in f.people(item) %}{{ face(p, "xs") }}{% endfor %}</span>
{%- endmacro %}

{#- Where someone is: home / a zone / away — never coordinates. -#}
{% macro whereabouts(p) -%}
{% if p.presence == "home" %}<span aria-hidden="true">🏠</span> {{ t("dashboard.presence.home") }}
{%- elif p.presence == "zone" and p.zone_name %}<span aria-hidden="true">📍</span> {{ p.zone_name }}
{%- elif p.presence in ("zone", "away") %}<span aria-hidden="true">🚗</span> {{ t("dashboard.presence.away") }}
{%- endif %}
{%- endmacro %}

{#- One line of a day list: time, (icon) title, timetable state, room /
    teacher. A cancelled lesson is struck through AND labelled; a
    changed one says so — never colour alone. -#}
{% macro agenda_row(item, with_people=False) -%}
{%- set lesson = item.item_type == "lesson" -%}
<li class="dash-row {{ f.kc(f.item_color(item)) }}{% if f.is_past(item) %} dash-past{% endif %}{% if f.is_now(item) %} dash-current{% endif %}{% if lesson %} dash-st-{{ item.status }}{% if item.kind == "break" %} dash-break{% endif %}{% endif %}">
  <span class="dash-row-time">{{ f.span(item) }}</span>
  <span class="dash-row-main">
    <span class="dash-row-title">{% if f.icon(item) %}<span aria-hidden="true">{{ f.icon(item) }}</span> {% endif %}{{ f.title(item) }}</span>
    {%- if lesson and item.status == "cancelled" %} <span class="dash-tag dash-tag-warn"><span aria-hidden="true">✕</span> {{ t("dashboard.lesson.cancelled") }}</span>
    {%- elif lesson and item.status == "changed" %} <span class="dash-tag"><span aria-hidden="true">🔁</span> {{ t("dashboard.lesson.changed") }}</span>
    {%- elif lesson and item.status == "added" %} <span class="dash-tag"><span aria-hidden="true">+</span> {{ t("dashboard.lesson.added") }}</span>
    {%- endif %}
    {%- if f.is_now(item) %} <span class="dash-tag dash-tag-now" data-live>{{ t("dashboard.timeline.now") }}</span>{% endif %}
    {%- if f.lesson_meta(item) %}
    <span class="dash-row-meta">{{ f.lesson_meta(item) }}</span>
    {%- endif %}
  </span>
  {%- if with_people %} {{ faces(item) }}{% endif %}
</li>
{%- endmacro %}

{#- A chore: ✓ done / ⚠ overdue / ☐ open, spoken too. -#}
{% macro chore(c, show_people=True, show_due=False) -%}
<li class="dash-chore{% if c.done %} dash-chore-done{% elif c.overdue_days %} dash-chore-late{% endif %}">
  <span class="dash-glyph" aria-hidden="true">{% if c.done %}✓{% elif c.overdue_days %}⚠{% else %}☐{% endif %}</span>
  <span class="dash-visually-hidden">{% if c.done %}{{ t("dashboard.chore.done") }}{% elif c.overdue_days %}{{ t("dashboard.chore.overdue") }}{% else %}{{ t("dashboard.chore.open") }}{% endif %}:</span>
  <span class="dash-chore-text">
    <span class="dash-chore-title">{{ c.title }}</span>
    {%- if c.overdue_days and not c.done %} <span class="dash-chore-late-text">· {{ f.late(c.overdue_days) }}</span>
    {%- elif show_due and f.due(c.due) and not c.done %} <span class="dash-chore-due">· {{ f.due(c.due) }}</span>
    {%- endif %}
  </span>
  {%- if show_people %} {{ faces(c.person_ids) }}{% endif %}
</li>
{%- endmacro %}

{#- ── Picture view (no words except names, no digits) ───────────────── -#}

{#- The analog clock: hands set from the household time (dashboard.js
    turns them each minute through their transform attribute) and the
    time-timer wedge until NEXT. SVG attributes only — never style=. -#}
{% macro analog_clock(c, cls="", wedge=True) -%}
<svg class="dash-pv-clock{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 200 200" role="img" aria-label="{{ c.label }}" focusable="false">
<circle class="dash-pv-dial" cx="100" cy="100" r="96"/>
{%- if c.wedge and wedge %}
<g class="dash-pv-wedge {{ c.color }}" data-rel>
{%- if c.wedge.full %}<circle cx="100" cy="100" r="88"/>{% else %}<path d="{{ c.wedge.path }}"/>{% endif -%}
</g>
{%- endif %}
{%- for i in range(12) %}
<line class="dash-pv-tick{% if i % 3 == 0 %} dash-pv-tick-major{% endif %}" x1="100" y1="10" x2="100" y2="{{ 28 if i % 3 == 0 else 22 }}" transform="rotate({{ i * 30 }} 100 100)"/>
{%- endfor %}
<line class="dash-pv-hand dash-pv-hand-h" x1="100" y1="100" x2="100" y2="54" transform="{{ c.hour }}" data-hand="hour"/>
<line class="dash-pv-hand dash-pv-hand-m" x1="100" y1="100" x2="100" y2="24" transform="{{ c.minute }}" data-hand="minute"/>
<circle class="dash-pv-hub" cx="100" cy="100" r="7"/>
</svg>
{%- endmacro %}

{#- An emoji tile; the real title is spoken, never shown. -#}
{% macro pv_tile(tile) -%}
<li class="dash-pv-tile {{ tile.color }}{% if tile.past %} dash-pv-past{% endif %}{% if tile.current %} dash-pv-current{% endif %}{% if tile.cancelled %} dash-pv-cancelled{% endif %}"{% if tile.current %} data-live{% endif %}>
<span class="dash-pv-emoji" role="img" aria-label="{{ tile.label }}">{{ tile.icon }}</span>
{%- if tile.cancelled %}<span class="dash-pv-x" aria-hidden="true">✕</span>{% endif -%}
</li>
{%- endmacro %}

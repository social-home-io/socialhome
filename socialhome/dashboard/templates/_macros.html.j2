{#- Shared bits. Import "with context" (they use f and t). -#}

{#- A person's face: their picture, else initials on their colour. The
    name is spoken (visually hidden) unless `named` shows it — or not at
    all with `spoken=False` (the caller names them itself). -#}
{% macro face(p, size="md", named=False, spoken=True) -%}
<span class="dash-face dash-face-{{ size }} {{ f.kc(p.color) }}" aria-hidden="true">
{%- set url = f.avatar(p) -%}
<span class="dash-initials">{{ p.initials }}</span>
{%- if url %}<img src="{{ url }}" alt="" decoding="async">{% endif -%}
</span>
{%- if named %}<span class="dash-face-name">{{ p.display_name }}</span>{% elif spoken %}<span class="dash-visually-hidden">{{ p.display_name }}</span>{% endif %}
{%- endmacro %}

{#- Small faces for everyone an item belongs to. -#}
{% macro faces(item) -%}
<span class="dash-faces">{% for p in f.people(item) %}{{ face(p, "xs") }}{% endfor %}</span>
{%- endmacro %}

{#- Where someone is: home / a zone / away — never coordinates. -#}
{% macro whereabouts(p) -%}
{% if p.presence == "home" %}<span aria-hidden="true">🏠</span> {{ t("dashboard.presence.home") }}
{%- elif p.presence == "zone" and p.zone_name %}<span aria-hidden="true">📍</span> {{ p.zone_name }}
{%- elif p.presence in ("zone", "away") %}<span aria-hidden="true">🚗</span> {{ t("dashboard.presence.away") }}
{%- endif %}
{%- endmacro %}

{#- One line of a day list: time, (icon) title, timetable state, room /
    teacher. A cancelled lesson is struck through AND labelled; a
    changed one says so — never colour alone. -#}
{% macro agenda_row(item, with_people=False) -%}
{%- set lesson = item.item_type == "lesson" -%}
<li class="dash-row {{ f.kc(f.item_color(item)) }}{% if f.is_past(item) %} dash-past{% endif %}{% if f.is_now(item) %} dash-current{% endif %}{% if lesson %} dash-st-{{ item.status }}{% if item.kind == "break" %} dash-break{% endif %}{% endif %}">
  <span class="dash-row-time">{{ f.span(item) }}</span>
  <span class="dash-row-main">
    <span class="dash-row-title">{% if f.icon(item) %}<span aria-hidden="true">{{ f.icon(item) }}</span> {% endif %}{{ f.title(item) }}</span>
    {%- if lesson and item.status == "cancelled" %} <span class="dash-tag dash-tag-warn"><span aria-hidden="true">✕</span> {{ t("dashboard.lesson.cancelled") }}</span>
    {%- elif lesson and item.status == "changed" %} <span class="dash-tag"><span aria-hidden="true">🔁</span> {{ t("dashboard.lesson.changed") }}</span>
    {%- elif lesson and item.status == "added" %} <span class="dash-tag"><span aria-hidden="true">+</span> {{ t("dashboard.lesson.added") }}</span>
    {%- endif %}
    {%- if f.is_now(item) %} <span class="dash-tag dash-tag-now" data-live>{{ t("dashboard.timeline.now") }}</span>{% endif %}
    {%- if f.lesson_meta(item) %}
    <span class="dash-row-meta">{{ f.lesson_meta(item) }}</span>
    {%- endif %}
  </span>
  {%- if with_people %} {{ faces(item) }}{% endif %}
</li>
{%- endmacro %}

{#- A chore: ✓ done / ⚠ overdue / ☐ open, spoken too. -#}
{% macro chore(c, show_people=True, show_due=False) -%}
<li class="dash-chore{% if c.done %} dash-chore-done{% elif c.overdue_days %} dash-chore-late{% endif %}">
  <span class="dash-glyph" aria-hidden="true">{% if c.done %}✓{% elif c.overdue_days %}⚠{% else %}☐{% endif %}</span>
  <span class="dash-visually-hidden">{% if c.done %}{{ t("dashboard.chore.done") }}{% elif c.overdue_days %}{{ t("dashboard.chore.overdue") }}{% else %}{{ t("dashboard.chore.open") }}{% endif %}:</span>
  <span class="dash-chore-text">
    <span class="dash-chore-title">{{ c.title }}</span>
    {%- if c.overdue_days and not c.done %} <span class="dash-chore-late-text">· {{ f.late(c.overdue_days) }}</span>
    {%- elif show_due and f.due(c.due) and not c.done %} <span class="dash-chore-due">· {{ f.due(c.due) }}</span>
    {%- endif %}
  </span>
  {%- if show_people %} {{ faces(c.person_ids) }}{% endif %}
</li>
{%- endmacro %}

{#- ── Picture view (pictures first; small helper captions) ──────────────
    The child reads the emoji. Under each sits a small muted caption for
    a grown-up reading along; screen readers hear the tile's own
    aria-label instead, so captions and section labels are aria-hidden. -#}

{#- A section's quiet small-caps label ("Now", "My day" …). -#}
{% macro pv_sec(text) -%}
<span class="dash-pv-sec" aria-hidden="true">{{ text }}</span>
{%- endmacro %}

{#- A tile's caption — struck through for a cancelled lesson (whose ✕
    and aria-label already say so). -#}
{% macro pv_cap(text, cancelled=False) -%}
{%- if text %}<span class="dash-pv-cap{% if cancelled %} dash-pv-cap-cancelled{% endif %}" aria-hidden="true">{{ text }}</span>{% endif -%}
{%- endmacro %}

{#- The analog clock: hands set from the household time (dashboard.js
    re-checks every second and writes their transform attribute when
    they change) and the
    time-timer wedge until NEXT. SVG attributes only — never style=. -#}
{% macro analog_clock(c, cls="", wedge=True) -%}
<svg class="dash-pv-clock{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 200 200" role="img" aria-label="{{ c.label }}" focusable="false">
<circle class="dash-pv-dial" cx="100" cy="100" r="96"/>
{%- if c.wedge and wedge %}
<g class="dash-pv-wedge {{ c.color }}" data-rel>
{%- if c.wedge.full %}<circle cx="100" cy="100" r="88"/>{% else %}<path d="{{ c.wedge.path }}"/>{% endif -%}
</g>
{%- endif %}
{%- for i in range(12) %}
<line class="dash-pv-tick{% if i % 3 == 0 %} dash-pv-tick-major{% endif %}" x1="100" y1="10" x2="100" y2="{{ 28 if i % 3 == 0 else 22 }}" transform="rotate({{ i * 30 }} 100 100)"/>
{%- endfor %}
<line class="dash-pv-hand dash-pv-hand-h" x1="100" y1="100" x2="100" y2="54" transform="{{ c.hour }}" data-hand="hour"/>
<line class="dash-pv-hand dash-pv-hand-m" x1="100" y1="100" x2="100" y2="24" transform="{{ c.minute }}" data-hand="minute"/>
<circle class="dash-pv-hub" cx="100" cy="100" r="7"/>
</svg>
{%- endmacro %}

{#- An emoji tile: the real title (and time) is spoken; the title shows
    small underneath. -#}
{% macro pv_tile(tile) -%}
<li class="dash-pv-tile {{ tile.color }}{% if tile.past %} dash-pv-past{% endif %}{% if tile.current %} dash-pv-current{% endif %}{% if tile.cancelled %} dash-pv-cancelled{% endif %}"{% if tile.current %} data-live{% endif %}>
<span class="dash-pv-emoji" role="img" aria-label="{{ tile.label }}">{{ tile.icon }}</span>
{%- if tile.cancelled %}<span class="dash-pv-x" aria-hidden="true">✕</span>{% endif -%}
{{ pv_cap(tile.caption, tile.cancelled) }}
</li>
{%- endmacro %}

{#- ── Household-chat messages (messages.py) ─────────────────────────────
    Each is a real button: a tap reads `data-say` aloud (dashboard.js —
    only where the browser has a voice for the page language; the script
    then points the button at the "Read aloud" description and shows the
    🔊). -#}

{#- The description the script points every message button at. -#}
{% macro say_hint() -%}
<span id="dash-say-hint" hidden>{{ t("dashboard.messages.read_aloud") }}</span>
{%- endmacro %}

{#- Home: face, text (two lines at most), when. -#}
{% macro message_row(m) -%}
<li class="dash-msg-item">
<button type="button" class="dash-msg{% if m.new %} dash-msg-new{% endif %}" data-say="{{ m.say }}" data-msg="{{ m.id }}">
{{ face(m.person, "msg", spoken=False) }}
<span class="dash-msg-body">
<span class="dash-msg-text"><span class="dash-visually-hidden">{{ t("dashboard.messages.from", name=m.person.display_name) }}:</span> {% if m.icon %}<span aria-hidden="true">{{ m.icon }}</span> {% endif %}{{ m.text }}</span>
<span class="dash-msg-when">
{%- if m.new %}<span class="dash-tag dash-tag-now">{{ t("dashboard.messages.new") }}</span> <time datetime="{{ m.iso }}" data-rel>{{ m.when }}</time>
{%- else %}<time datetime="{{ m.iso }}">{{ m.when }}</time>{% endif -%}
</span>
</span>
<span class="dash-msg-speaker" aria-hidden="true">🔊</span>
</button>
</li>
{%- endmacro %}

{#- Home's Messages tab (messages.py ChatRow): the whole row is one
    toggle button — a tap reads the full message aloud, a second tap stops
    it (dashboard.js keeps aria-pressed and the live region in step). Face,
    name, "new" + the clock time, the text (cut on a word, with a "tap to
    hear the rest" cue) and the 🔊 (drawn only where speaking works). -#}
{% macro chat_row(r) -%}
{%- set m = r.message -%}
<li class="dash-chat-item">
<button type="button" class="dash-chat-msg{% if m.new %} dash-msg-new{% endif %}" aria-pressed="false" data-say="{{ m.say }}" data-say-playing="{{ r.playing }}" data-msg="{{ m.id }}">
{{ face(m.person, "chat", spoken=False) }}
<span class="dash-chat-body">
<span class="dash-chat-head"><span class="dash-chat-who">{{ m.person.display_name }}</span> <span class="dash-chat-when">{% if m.new %}<span class="dash-tag dash-tag-now">{{ t("dashboard.messages.new") }}</span> {% endif %}<time datetime="{{ m.iso }}">{{ r.time }}</time></span></span>
<span class="dash-chat-text"><span class="dash-visually-hidden">{{ t("dashboard.messages.from", name=m.person.display_name) }}:</span> {% if m.icon %}<span aria-hidden="true">{{ m.icon }}</span> {% endif %}{{ r.text }}</span>
{%- if r.rest %}<span class="dash-chat-rest"><span aria-hidden="true">🔊</span> {{ t("dashboard.messages.hear_rest") }}</span>{% endif %}
</span>
<span class="dash-chat-speaker" aria-hidden="true">🔊</span>
</button>
</li>
{%- endmacro %}

{#- Home's "See all ›" card-header link to a tab, read as "See all,
    <card label>". -#}
{% macro see_all(href, label_id) -%}
<a class="dash-see-all" href="{{ href }}" aria-describedby="{{ label_id }}">{{ t("dashboard.home.see_all") }}<span class="dash-see-all-arrow" aria-hidden="true">›</span></a>
{%- endmacro %}

{#- A tab with nothing in it: an icon, what's missing, where to add it
    (never an example of what to put on a wall screen). -#}
{% macro tab_empty(icon, title, text) -%}
<div class="dash-tab-empty">
<span class="dash-tab-empty-icon" aria-hidden="true">{{ icon }}</span>
<p class="dash-tab-empty-title">{{ title }}</p>
<p class="dash-tab-empty-text">{{ text }}</p>
</div>
{%- endmacro %}

{#- Picture view: the sender's face and a 💬, one short line of the text
    under it (a tap reads the whole message aloud). A new one's 💬 sits
    on a filled accent circle — never the ring the page owner's face
    wears. The tile itself is the affordance: its 🔊 is drawn by the CSS
    only while it speaks. -#}
{% macro message_tile(m) -%}
<li class="dash-pv-msg-item">
<button type="button" class="dash-pv-msg" aria-label="{{ t("dashboard.messages.from", name=m.person.display_name) }}" data-say="{{ m.say }}" data-msg="{{ m.id }}">
<span class="dash-pv-msg-face">
{{ face(m.person, "lg", spoken=False) }}
<span class="dash-pv-msg-badge{% if m.new %} dash-pv-msg-badge-new{% endif %}" aria-hidden="true">💬</span>
<span class="dash-pv-msg-speaker" aria-hidden="true"></span>
</span>
{{ pv_cap(m.caption) }}
</button>
</li>
{%- endmacro %}

{#- ── Household-chat mentions (messages.py MentionCard) ─────────────────
    "Got it" is a real form (works without JS); dashboard.js posts it in
    the background and refreshes. -#}

{% macro ack_form(m, round=False) -%}
<form class="dash-ack-form" method="post" action="/ack" data-ack>
<input type="hidden" name="message_id" value="{{ m.id }}">
{%- if m.person_id %}<input type="hidden" name="person_id" value="{{ m.person_id }}">{% endif %}
{%- if round %}
<button type="submit" class="dash-ack dash-ack-round" aria-label="{{ t("dashboard.mentions.got_it") }}"><span aria-hidden="true">✓</span></button>
{%- else %}
<button type="submit" class="dash-ack" aria-describedby="dash-mention-{{ m.key }}"><span aria-hidden="true">✓</span> {{ t("dashboard.mentions.got_it") }}</button>
{%- endif %}
</form>
{%- endmacro %}

{#- Home's @here banner and a reader page's own mention: label, sender
    face + name, when, the text, a big "Got it". -#}
{% macro mention_alert(m, label) -%}
<li class="dash-alert">
{{ face(m.person, "msg", spoken=False) }}
<div class="dash-alert-body">
<p class="dash-alert-head"><span class="dash-alert-label">{{ label }}</span> <span class="dash-alert-who">{{ m.person.display_name }}</span> <time datetime="{{ m.iso }}" data-rel>{{ m.when }}</time></p>
<p class="dash-alert-text" id="dash-mention-{{ m.key }}">{{ m.text }}</p>
</div>
{{ ack_form(m) }}
</li>
{%- endmacro %}

{#- Picture view: the sender's face + 💬 with one short line of the text
    (a tap reads it all aloud) and a big ✓. -#}
{% macro mention_tile(m) -%}
<li class="dash-pv-mention">
<button type="button" class="dash-pv-msg" aria-label="{{ t("dashboard.mentions.from_for_you", name=m.person.display_name) }}" data-say="{{ m.say }}" data-msg="mention-{{ m.id }}">
<span class="dash-pv-msg-face">
{{ face(m.person, "lg", spoken=False) }}
<span class="dash-pv-msg-badge dash-pv-msg-badge-new" aria-hidden="true">💬</span>
<span class="dash-pv-msg-speaker" aria-hidden="true"></span>
</span>
{{ pv_cap(m.caption) }}
</button>
{{ ack_form(m, round=True) }}
</li>
{%- endmacro %}

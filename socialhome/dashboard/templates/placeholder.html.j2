{% extends "base.html.j2" %}
{% block body_class %}dash-home{% endblock %}
{% block content %}
<section class="dash-card">
  <h1>{{ household }}</h1>
  <p class="dash-ready">{{ t("dashboard.ready") }}</p>
  {% if pin_set %}
  {% include "_lock_button.html.j2" %}
  {% endif %}
  <form method="post" action="/logout">
    <button type="submit" class="dash-button dash-button-quiet">{{ t("dashboard.sign_out") }}</button>
  </form>
</section>
{% endblock %}

      "label_en": null
    },
    {
      "name": "all-day without a zone reads as UTC",
      "start": "2026-05-01T00:00:00Z", "end": "2026-05-01T23:59:00Z", "all_day": true, "tz": null,
      "first": "2026-05-01", "last": "2026-05-01", "day_count": 1,
      "label_en": null
    },

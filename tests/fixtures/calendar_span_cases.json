      "first": "2026-10-26", "last": "2026-10-31", "day_count": 6,
      "label_en": "Mon 26 – Sat 31 · 6 days"
    },
    {
      "name": "span across a month names both months",
      "start": "2026-10-30T00:00:00Z", "end": "2026-11-02T23:59:00Z", "all_day": true, "tz": "UTC",
      "first": "2026-10-30", "last": "2026-11-02", "day_count": 4,
      "label_en": "Fri 30 Oct – Mon 2 Nov · 4 days"
    },
    {
      "name": "ICS-style exclusive midnight end of an all-day span",
      "start": "2026-10-26T00:00:00Z", "end": "2026-10-28T00:00:00Z", "all_day": true, "tz": "UTC",
      "first": "2026-10-26", "last": "2026-10-27", "day_count": 2,
      "label_en": "Mon 26 – Tue 27 · 2 days"
    },
    {
      "name": "all-day in Zurich is its own single day",
